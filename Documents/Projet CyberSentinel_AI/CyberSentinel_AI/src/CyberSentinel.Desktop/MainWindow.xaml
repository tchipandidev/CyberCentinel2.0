<Window x:Class="CyberSentinel.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CyberSentinel.Desktop.ViewModels"
        xmlns:enums="clr-namespace:CyberSentinel.Domain.Enums;assembly=CyberSentinel.Domain"
        mc:Ignorable="d"
        Title="CyberSentinel AI - Intelligent Threat, Vulnerability &amp; System Inventory Defense" 
        Height="840" Width="1320"
        MinHeight="700" MinWidth="1100"
        Background="#0D1117"
        Foreground="#F0F6FC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Palette de styles réutilisables -->
        <SolidColorBrush x:Key="CanvasBackground" Color="#0D1117"/>
        <SolidColorBrush x:Key="CardBackground" Color="#161B22"/>
        <SolidColorBrush x:Key="CardHoverBackground" Color="#21262D"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#30363D"/>
        <SolidColorBrush x:Key="CyanAccent" Color="#00D2FF"/>
        <SolidColorBrush x:Key="GreenSafe" Color="#3FB950"/>
        <SolidColorBrush x:Key="AmberWarning" Color="#D29922"/>
        <SolidColorBrush x:Key="RedDanger" Color="#F85149"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8B949E"/>

        <Style x:Key="CyberCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CyanAccent}"/>
            <Setter Property="Foreground" Value="#0D1117"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#33DCFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Background" Value="#30363D"/>
                                <Setter Property="Foreground" Value="#8B949E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardHoverBackground}"/>
            <Setter Property="Foreground" Value="#F0F6FC"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#30363D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#B62324"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{StaticResource RedDanger}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Background" Value="#30363D"/>
                                <Setter Property="Foreground" Value="#8B949E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- En-tête -->
            <RowDefinition Height="Auto"/> <!-- Cartes KPI Globales -->
            <RowDefinition Height="*"/>    <!-- Onglets Principaux -->
            <RowDefinition Height="Auto"/> <!-- Barre de statut -->
        </Grid.RowDefinitions>

        <!-- 1. EN-TÊTE PRINCIPAL -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="22" Margin="0,0,10,0"/>
                    <TextBlock Text="CyberSentinel" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC"/>
                    <TextBlock Text=" AI" FontSize="18" FontWeight="Bold" Foreground="{StaticResource CyanAccent}"/>
                    <Border Background="#21262D" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="EDR &amp; SYSTEM INVENTORY DEFENSE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource CyanAccent}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                    <Border Background="#21262D" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource GreenSafe}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Moteurs Multiples &amp; SQLite Actifs" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#21262D" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="Windows 11 x64" FontSize="11" Foreground="{StaticResource CyanAccent}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. CARTES KPI STATISTIQUES GLOBALES -->
        <Grid Grid.Row="1" Margin="20,14,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Analysés (Malware) -->
            <Border Grid.Column="0" Style="{StaticResource CyberCard}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="FICHIERS ANALYSÉS" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding Dashboard.TotalFilesScanned}" FontSize="22" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Menaces Détectées -->
            <Border Grid.Column="1" Style="{StaticResource CyberCard}" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="MENACES MALWARE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding Dashboard.ThreatsDetectedCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource RedDanger}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Logiciels Inventoriés -->
            <Border Grid.Column="2" Style="{StaticResource CyberCard}" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="LOGICIELS INSTALLÉS" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding Dashboard.TotalInstalledSoftwareCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource CyanAccent}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Vulnérabilités Détectées -->
            <Border Grid.Column="3" Style="{StaticResource CyberCard}" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="VULNÉRABILITÉS CVE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding Dashboard.CriticalVulnerabilitiesCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource RedDanger}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Mises à jour Disponibles -->
            <Border Grid.Column="4" Style="{StaticResource CyberCard}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="MISES À JOUR (WINGET)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding Dashboard.AvailableUpdatesCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AmberWarning}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. ZONE PRINCIPALE À 7 ONGLETS -->
        <TabControl Grid.Row="2" Margin="20,4,20,10" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="tabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="16,8" Cursor="Hand">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource CyanAccent}"/>
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource CyanAccent}"/>
                                        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource TextMuted}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ============================================================== -->
            <!-- ONGLET 1 : DASHBOARD PRINCIPAL & SÉCURITÉ GLOBALE              -->
            <!-- ============================================================== -->
            <TabItem Header="📊 Dashboard Principal" DataContext="{Binding Dashboard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- LIGNE 1 : Filtre temporel et Export de rapport -->
                        <Border Grid.Row="0" Style="{StaticResource CyberCard}" Margin="0,0,0,10" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Période d'analyse :" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding TimeFilters}" SelectedItem="{Binding SelectedTimeFilter}" 
                                              Width="160" FontSize="12" Background="#21262D" Foreground="#F0F6FC" BorderBrush="{StaticResource BorderSubtle}"/>
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource CyanAccent}" FontSize="11.5" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="🔄 Actualiser" Style="{StaticResource SecondaryButton}" 
                                        Command="{Binding RefreshCommand}" Margin="6,0,0,0" Padding="12,6"/>

                                <Button Grid.Column="2" Content="📄 Exporter Rapport PDF" Style="{StaticResource PrimaryButton}" 
                                        Command="{Binding ExportPdfCommand}" Margin="6,0,0,0" Padding="14,6"/>

                                <Button Grid.Column="3" Content="💾 Export JSON" Style="{StaticResource SecondaryButton}" 
                                        Command="{Binding ExportJsonCommand}" Margin="6,0,0,0" Padding="10,6"/>
                            </Grid>
                        </Border>

                        <!-- LIGNE 2 : Bannière Posture Globale & Dernier Scan -->
                        <Border Grid.Row="1" Style="{StaticResource CyberCard}" Margin="0,0,0,10" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Score de Posture -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="POSTURE DE SÉCURITÉ SYSTÈME" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                        <TextBlock Text="{Binding SecurityScore, StringFormat='{}{0:F1}'}" FontSize="36" FontWeight="Bold" Foreground="{Binding PostureColor}"/>
                                        <TextBlock Text=" / 100" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SecurityVerdict}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding PostureColor}"/>
                                </StackPanel>

                                <!-- Dernier Scan -->
                                <Border Grid.Column="1" Background="#0D1117" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="DERNIÈRE ANALYSE EFFECTUÉE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource CyanAccent}"/>
                                        
                                        <Grid Grid.Row="1" Margin="0,6,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Date &amp; Heure" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock Text="{Binding LastScanDateFormatted}" FontSize="12" FontWeight="SemiBold" Foreground="#F0F6FC"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Verdict Global" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock Text="{Binding LastScanVerdict}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AmberWarning}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Durée d'Exécution" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock Text="{Binding LastScanDurationMs, StringFormat='{}{0} ms'}" FontSize="12" FontWeight="SemiBold" Foreground="#F0F6FC"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Grid.Row="2" Text="{Binding LastScanTargetPath, StringFormat='Cible : {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- LIGNE 3 : Grille KPI Détaillée (6 Cartes) -->
                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Fichiers Analysés -->
                            <Border Grid.Column="0" Style="{StaticResource CyberCard}" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="FICHIERS ANALYSÉS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding TotalFilesScanned}" FontSize="20" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Menaces Détectées -->
                            <Border Grid.Column="1" Style="{StaticResource CyberCard}" Margin="2,0,2,0">
                                <StackPanel>
                                    <TextBlock Text="MENACES MALWARE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource RedDanger}"/>
                                    <TextBlock Text="{Binding ThreatsDetectedCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource RedDanger}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Fichiers Suspects -->
                            <Border Grid.Column="2" Style="{StaticResource CyberCard}" Margin="2,0,2,0">
                                <StackPanel>
                                    <TextBlock Text="FICHIERS SUSPECTS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AmberWarning}"/>
                                    <TextBlock Text="{Binding SuspiciousFilesCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AmberWarning}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Vulnérabilités Critiques -->
                            <Border Grid.Column="3" Style="{StaticResource CyberCard}" Margin="2,0,2,0">
                                <StackPanel>
                                    <TextBlock Text="CVE CRITIQUES" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource RedDanger}"/>
                                    <TextBlock Text="{Binding CriticalVulnerabilitiesCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource RedDanger}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Vulnérabilités Élevées -->
                            <Border Grid.Column="4" Style="{StaticResource CyberCard}" Margin="2,0,2,0">
                                <StackPanel>
                                    <TextBlock Text="CVE ÉLEVÉES" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AmberWarning}"/>
                                    <TextBlock Text="{Binding HighVulnerabilitiesCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AmberWarning}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Mises à Jour Disponibles -->
                            <Border Grid.Column="5" Style="{StaticResource CyberCard}" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="MÀJ DISPONIBLES" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource CyanAccent}"/>
                                    <TextBlock Text="{Binding AvailableUpdatesCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CyanAccent}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- LIGNE 4 : Tableaux Récapitulatifs (Analyses Récentes + Alertes) -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Dernières Sessions d'Analyse -->
                            <Border Grid.Column="0" Style="{StaticResource CyberCard}" Padding="12" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="HISTORIQUE RÉCENT DES SESSIONS D'ANALYSE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>

                                    <DataGrid Grid.Row="1" ItemsSource="{Binding RecentSessions}" AutoGenerateColumns="False" 
                                              CanUserAddRows="False" IsReadOnly="True" MaxHeight="220"
                                              Background="Transparent" RowBackground="#161B22" AlternatingRowBackground="#1C2129"
                                              BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#21262D"
                                              Foreground="#F0F6FC">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#21262D"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="10.5"/>
                                                <Setter Property="Padding" Value="6,5"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush" Value="#30363D"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>

                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="DATE" Binding="{Binding FormattedDate}" Width="125"/>
                                            <DataGridTextColumn Header="TYPE" Binding="{Binding ScanTypeBadge}" Width="110"/>
                                            <DataGridTextColumn Header="VERDICT" Binding="{Binding GlobalVerdictBadge}" Width="130" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="FICHIERS" Binding="{Binding TotalFilesCount}" Width="65"/>
                                            <DataGridTextColumn Header="DURÉE" Binding="{Binding FormattedDuration}" Width="70"/>
                                            <DataGridTextColumn Header="CIBLE" Binding="{Binding TargetPath}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <!-- Alertes & Vulnérabilités Prioritaires -->
                            <Border Grid.Column="1" Style="{StaticResource CyberCard}" Padding="12" Margin="6,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="ALERTES &amp; VULNÉRABILITÉS CVE PRIORITAIRES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RedDanger}" Margin="0,0,0,8"/>

                                    <DataGrid Grid.Row="1" ItemsSource="{Binding TopVulnerabilities}" AutoGenerateColumns="False" 
                                              CanUserAddRows="False" IsReadOnly="True" MaxHeight="220"
                                              Background="Transparent" RowBackground="#161B22" AlternatingRowBackground="#1C2129"
                                              BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#21262D"
                                              Foreground="#F0F6FC">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#21262D"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="10.5"/>
                                                <Setter Property="Padding" Value="6,5"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush" Value="#30363D"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>

                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="CVE ID" Binding="{Binding CveId}" Width="110" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="CVSS" Binding="{Binding FormattedCvssScore}" Width="50" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="SÉVÉRITÉ" Binding="{Binding SeverityBadge}" Width="75"/>
                                            <DataGridTextColumn Header="APPLICATION" Binding="{Binding AffectedSoftware}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================== -->
            <!-- ONGLET 2 : SCANNER DE MENACES (MALWARE)    -->
            <!-- ========================================== -->
            <TabItem Header="🔍 Scanner Antivirus &amp; YARA" DataContext="{Binding Scanner}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CyberCard}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding SelectedPath, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D" 
                                     BorderThickness="1" Padding="10,8" VerticalAlignment="Center" FontSize="12.5"/>

                            <Button Grid.Column="1" Content="📄 Fichier..." Style="{StaticResource SecondaryButton}" 
                                    Margin="8,0,0,0" Command="{Binding BrowseFileCommand}"/>

                            <Button Grid.Column="2" Content="📁 Dossier..." Style="{StaticResource SecondaryButton}" 
                                    Margin="6,0,0,0" Command="{Binding BrowseFolderCommand}"/>

                            <Button Grid.Column="3" Content="🚀 Lancer le Scan" Style="{StaticResource PrimaryButton}" 
                                    Margin="10,0,0,0" Command="{Binding ScanFileCommand}"/>

                            <Button Grid.Column="4" Content="⛔ Annuler" Style="{StaticResource DangerButton}" 
                                    Margin="6,0,0,0" Command="{Binding CancelScanCommand}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                            Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="{Binding CurrentFileName}" FontSize="12" Foreground="{StaticResource CyanAccent}" 
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:F0}%}" FontSize="12" FontWeight="SemiBold" 
                                           HorizontalAlignment="Right" Foreground="#F0F6FC"/>
                            </Grid>

                            <ProgressBar Grid.Row="1" Height="6" Value="{Binding ProgressPercentage}" Maximum="100" 
                                         Foreground="{StaticResource CyanAccent}" Background="#21262D" BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CyberCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0" ItemsSource="{Binding ScannedFiles}" SelectedItem="{Binding SelectedFile}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      Background="Transparent" RowBackground="#161B22" AlternatingRowBackground="#1C2129"
                                      BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#21262D"
                                      Foreground="#F0F6FC" SelectionMode="Single">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#21262D"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="11.5"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#30363D"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="VERDICT" Binding="{Binding Verdict}" Width="110" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="RISQUE" Binding="{Binding RiskLevel}" Width="90"/>
                                    <DataGridTextColumn Header="FICHIER" Binding="{Binding FileName}" Width="220" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="DÉTAILS DES MENACES" Binding="{Binding DetectionSummary}" Width="*"/>
                                    <DataGridTextColumn Header="TAILLE" Binding="{Binding FormattedSize}" Width="90"/>
                                    <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256Hash}" Width="240" FontFamily="Consolas" FontSize="11"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="1" Background="#21262D" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="12,8">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="🛡️ Mettre en quarantaine le fichier sélectionné" 
                                            Style="{StaticResource DangerButton}" 
                                            Command="{Binding QuarantineSelectedCommand}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- ONGLET 2 : COFFRE-FORT DE QUARANTAINE      -->
            <!-- ========================================== -->
            <TabItem Header="🛡️ Coffre de Quarantaine" DataContext="{Binding Scanner}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CyberCard}" Margin="0,0,0,10">
                        <TextBlock Text="Les fichiers placés en quarantaine sont chiffrés sous l'extension .locked et isolés. Ils ne peuvent plus être exécutés."
                                   Foreground="{StaticResource TextMuted}" FontSize="12.5"/>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CyberCard}" Padding="0">
                        <DataGrid ItemsSource="{Binding QuarantinedItems}" SelectedItem="{Binding SelectedQuarantineItem}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  Background="Transparent" RowBackground="#161B22" AlternatingRowBackground="#1C2129"
                                  BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#21262D"
                                  Foreground="#F0F6FC" SelectionMode="Single">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#21262D"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#30363D"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NOM ORIGINAL" Binding="{Binding OriginalFileName}" Width="220" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="MOTIF DE MISE EN QUARANTAINE" Binding="{Binding DetectionReason}" Width="*"/>
                                <DataGridTextColumn Header="DATE D'ISOLATION" Binding="{Binding QuarantinedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="150"/>
                                <DataGridTextColumn Header="HASH SHA-256" Binding="{Binding Sha256Hash}" Width="250" FontFamily="Consolas" FontSize="11"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2" Background="#21262D" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="12,10" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="↩ Restaurer le fichier sélectionné" Style="{StaticResource SecondaryButton}" 
                                    Margin="0,0,10,0" Command="{Binding RestoreQuarantineCommand}"/>
                            <Button Content="🗑️ Détruire définitivement" Style="{StaticResource DangerButton}" 
                                    Command="{Binding PurgeQuarantineCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- ONGLET 3 : INVENTAIRE SYSTÈME (SCANNER)    -->
            <!-- ========================================== -->
            <TabItem Header="📦 Inventaire Système" DataContext="{Binding Inventory}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Barre de filtres & recherche -->
                        <RowDefinition Height="Auto"/> <!-- Barre de progression -->
                        <RowDefinition Height="*"/>    <!-- Grille & Détails -->
                    </Grid.RowDefinitions>

                    <!-- Barre de Recherche et d'Actions -->
                    <Border Grid.Row="0" Style="{StaticResource CyberCard}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Champ de recherche en direct -->
                            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D" 
                                     BorderThickness="1" Padding="10,8" VerticalAlignment="Center" FontSize="12.5"/>

                            <!-- Bouton effacer recherche -->
                            <Button Grid.Column="1" Content="✕" Style="{StaticResource SecondaryButton}" 
                                    Margin="4,0,10,0" Padding="10,7" Command="{Binding ClearSearchCommand}" ToolTip="Effacer le filtre"/>

                            <!-- Filtre d'Architecture -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Arch:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                                <ComboBox SelectedValue="{Binding SelectedArchitectureFilter}" SelectedValuePath="Content"
                                          Background="#161B22" Foreground="#0D1117" Width="100" Height="32">
                                    <ComboBoxItem Content="Tous" IsSelected="True"/>
                                    <ComboBoxItem Content="64-bit"/>
                                    <ComboBoxItem Content="32-bit"/>
                                    <ComboBoxItem Content="Autres / Neutre"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Bouton Lancer l'inventaire -->
                            <Button Grid.Column="3" Content="🚀 Lancer l'Inventaire" Style="{StaticResource PrimaryButton}" 
                                    Margin="0,0,6,0" Command="{Binding ScanInventoryCommand}"/>

                            <!-- Bouton Annuler -->
                            <Button Grid.Column="4" Content="⛔ Annuler" Style="{StaticResource DangerButton}" 
                                    Margin="0,0,6,0" Command="{Binding CancelScanCommand}"/>

                            <!-- Bouton Exporter CSV -->
                            <Button Grid.Column="5" Content="📥 Exporter CSV" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ExportCsvCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Barre de statut & progression -->
                    <Border Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="{Binding ScanStatus}" FontSize="12" Foreground="{StaticResource CyanAccent}"/>
                                <TextBlock Text="{Binding FilteredApplications.Count, StringFormat={}{0} application(s) affichée(s)}" 
                                           FontSize="11.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                            </Grid>

                            <ProgressBar Grid.Row="1" Height="4" Value="{Binding ScanProgress}" Maximum="100" 
                                         Foreground="{StaticResource CyanAccent}" Background="#21262D" BorderThickness="0"
                                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <!-- Grille Principale et Fiche Détail -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tableau des Logiciels -->
                        <Border Grid.Column="0" Style="{StaticResource CyberCard}" Padding="0" Margin="0,0,8,0">
                            <DataGrid ItemsSource="{Binding FilteredApplications}" SelectedItem="{Binding SelectedApplication}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      Background="Transparent" RowBackground="#161B22" AlternatingRowBackground="#1C2129"
                                      BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#21262D"
                                      Foreground="#F0F6FC" SelectionMode="Single">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#21262D"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="11.5"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#30363D"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="APPLICATION" Binding="{Binding DisplayName}" Width="230" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="ÉDITEUR" Binding="{Binding Publisher}" Width="160"/>
                                    <DataGridTextColumn Header="VERSION" Binding="{Binding DisplayVersion}" Width="100"/>
                                    <DataGridTextColumn Header="ARCH" Binding="{Binding ArchitectureBadge}" Width="65" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="INSTALLÉ LE" Binding="{Binding FormattedInstallDate}" Width="95"/>
                                    <DataGridTextColumn Header="SOURCE" Binding="{Binding IdentificationSource}" Width="120"/>
                                    <DataGridTextColumn Header="WINGET ID" Binding="{Binding PackageIdentifier}" Width="180" FontFamily="Consolas"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Fiche Détail Latérale -->
                        <Border Grid.Column="1" Style="{StaticResource CyberCard}" Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="FICHE LOGICIELLE DÉTAILLÉE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyanAccent}" Margin="0,0,0,12"/>

                                    <TextBlock Text="NOM DU LOGICIEL" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding SelectedApplication.DisplayName, FallbackValue='Sélectionnez une application'}" 
                                               FontSize="14" FontWeight="Bold" Foreground="#F0F6FC" TextWrapping="Wrap" Margin="0,2,0,10"/>

                                    <TextBlock Text="ÉDITEUR" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding SelectedApplication.Publisher, FallbackValue='-'}" FontSize="12.5" Foreground="#F0F6FC" Margin="0,2,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="VERSION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding SelectedApplication.DisplayVersion, FallbackValue='-'}" FontSize="12.5" Foreground="#F0F6FC" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="ARCHITECTURE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding SelectedApplication.ArchitectureBadge, FallbackValue='-'}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource CyanAccent}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="DATE D'INSTALLATION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding SelectedApplication.FormattedInstallDate, FallbackValue='-'}" FontSize="12.5" Foreground="#F0F6FC" Margin="0,2,0,10"/>

                                    <TextBlock Text="IDENTIFIANT WINGET" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding SelectedApplication.PackageIdentifier, FallbackValue='Non associé'}" 
                                               FontSize="11.5" FontFamily="Consolas" Foreground="{StaticResource GreenSafe}" Margin="0,2,0,10"/>

                                    <TextBlock Text="SOURCE D'IDENTIFICATION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding SelectedApplication.IdentificationSource, FallbackValue='-'}" FontSize="12" Foreground="#F0F6FC" Margin="0,2,0,10"/>

                                    <TextBlock Text="RÉPERTOIRE D'INSTALLATION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding SelectedApplication.InstallLocation, FallbackValue='Non spécifié'}" 
                                               FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================================================== -->
            <!-- ONGLET : CENTRE DE GESTION DES VULNÉRABILITÉS (NVD / CVE / OSV)-->
            <!-- ============================================================== -->
            <TabItem Header="🛡️ Centre de Vulnérabilités (CVE &amp; NVD)" DataContext="{Binding Vulnerabilities}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- LIGNE 1 : Statut et Actions -->
                    <Border Grid.Row="0" Style="{StaticResource CyberCard}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" Foreground="{StaticResource CyanAccent}" FontWeight="SemiBold"/>
                                <ProgressBar Height="4" Value="{Binding ProgressPercent}" Maximum="100" Margin="0,6,15,0"
                                             Foreground="{StaticResource CyanAccent}" Background="#21262D" BorderThickness="0"
                                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="🚀 Lancer l'Audit CVE / NVD" Style="{StaticResource PrimaryButton}" 
                                    Margin="10,0,0,0" Command="{Binding ScanCommand}"/>

                            <Button Grid.Column="2" Content="⛔ Annuler" Style="{StaticResource DangerButton}" 
                                    Margin="6,0,0,0" Command="{Binding CancelScanCommand}"/>

                            <Button Grid.Column="3" Content="📥 Exporter CSV" Style="{StaticResource SecondaryButton}" 
                                    Margin="6,0,0,0" Command="{Binding ExportCsvCommand}"/>
                        </Grid>
                    </Border>

                    <!-- LIGNE 2 : Cartes KPI -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total Vulnérabilités -->
                        <Border Grid.Column="0" Style="{StaticResource CyberCard}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL VULNÉRABILITÉS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding TotalVulnerabilitiesCount}" FontSize="24" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Vulnérabilités Critiques -->
                        <Border Grid.Column="1" Style="{StaticResource CyberCard}" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="CRITIQUES (CVSS ≥ 9.0)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource RedDanger}"/>
                                <TextBlock Text="{Binding CriticalCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource RedDanger}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Vulnérabilités Élevées -->
                        <Border Grid.Column="2" Style="{StaticResource CyberCard}" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="ÉLEVÉES (CVSS 7.0 - 8.9)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AmberWarning}"/>
                                <TextBlock Text="{Binding HighCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AmberWarning}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Vulnérabilités Confirmées -->
                        <Border Grid.Column="3" Style="{StaticResource CyberCard}" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="CORRESPONDANCES CONFIRMÉES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CyanAccent}"/>
                                <TextBlock Text="{Binding ConfirmedCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource CyanAccent}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Correctifs Disponibles -->
                        <Border Grid.Column="4" Style="{StaticResource CyberCard}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="CORRECTIFS DISPONIBLES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GreenSafe}"/>
                                <TextBlock Text="{Binding PatchesAvailableCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource GreenSafe}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- LIGNE 3 : Barre de Filtres et Recherche -->
                    <Border Grid.Row="2" Style="{StaticResource CyberCard}" Margin="0,0,0,10" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Recherche par mot-clé -->
                            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#0D1117" Foreground="#F0F6FC" BorderBrush="{StaticResource BorderSubtle}"
                                     FontSize="12" Padding="8,6" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <!-- Filtre Sévérité -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Sévérité :" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding SeverityFilters}" SelectedItem="{Binding SelectedSeverityFilter}" 
                                          Width="110" FontSize="12" Background="#21262D" Foreground="#F0F6FC" BorderBrush="{StaticResource BorderSubtle}"/>
                            </StackPanel>

                            <!-- Filtre Statut de correspondance -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Statut :" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" 
                                          Width="150" FontSize="12" Background="#21262D" Foreground="#F0F6FC" BorderBrush="{StaticResource BorderSubtle}"/>
                            </StackPanel>

                            <!-- Checkbox Patch dispo -->
                            <CheckBox Grid.Column="3" Content="Correctif dispo" IsChecked="{Binding OnlyWithPatches}" 
                                      VerticalAlignment="Center" Foreground="#F0F6FC" FontSize="12" Margin="0,0,10,0"/>

                            <!-- Bouton Reset -->
                            <Button Grid.Column="4" Content="🧹 Réinitialiser" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ClearFiltersCommand}" Padding="10,5"/>
                        </Grid>
                    </Border>

                    <!-- LIGNE 4 : Vue Master-Detail (Tableau + Volet de détails) -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tableau des vulnérabilités -->
                        <Border Grid.Column="0" Style="{StaticResource CyberCard}" Padding="0" Margin="0,0,6,0">
                            <DataGrid ItemsSource="{Binding FilteredVulnerabilities}" SelectedItem="{Binding SelectedVulnerability}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      Background="Transparent" RowBackground="#161B22" AlternatingRowBackground="#1C2129"
                                      BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#21262D"
                                      Foreground="#F0F6FC" SelectionMode="Single">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#21262D"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#30363D"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CVE ID" Binding="{Binding CveId}" Width="130" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="SÉVÉRITÉ" Binding="{Binding SeverityBadge}" Width="90" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="CVSS" Binding="{Binding FormattedCvssScore}" Width="55" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="STATUT" Binding="{Binding MatchStatusBadge}" Width="120"/>
                                    <DataGridTextColumn Header="LOGICIEL AFFECTÉ" Binding="{Binding AffectedSoftware}" Width="150"/>
                                    <DataGridTextColumn Header="VERSION" Binding="{Binding InstalledVersion}" Width="85"/>
                                    <DataGridCheckBoxColumn Header="PATCH" Binding="{Binding PatchAvailable}" Width="55"/>
                                    <DataGridTextColumn Header="DATE PUBLIÉE" Binding="{Binding FormattedPublishedDate}" Width="95"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Volet latéral de détails de la CVE sélectionnée -->
                        <Border Grid.Column="1" Style="{StaticResource CyberCard}" Margin="6,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Visibility="{Binding HasSelectedVulnerability, Converter={StaticResource BoolToVis}}">
                                    <!-- Titre & Identifiant -->
                                    <TextBlock Text="{Binding SelectedVulnerability.CveId}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource CyanAccent}"/>
                                    <TextBlock Text="{Binding SelectedVulnerability.AffectedSoftware, StringFormat='Composant affecté : {0}'}" 
                                               FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,12"/>

                                    <!-- Badges d'état -->
                                    <WrapPanel Margin="0,0,0,12">
                                        <Border Background="#21262D" CornerRadius="3" Padding="8,3" Margin="0,0,6,4">
                                            <TextBlock Text="{Binding SelectedVulnerability.SeverityBadge, StringFormat='Sévérité : {0}'}" 
                                                       FontSize="11" FontWeight="Bold" Foreground="{StaticResource AmberWarning}"/>
                                        </Border>

                                        <Border Background="#21262D" CornerRadius="3" Padding="8,3" Margin="0,0,6,4">
                                            <TextBlock Text="{Binding SelectedVulnerability.FormattedCvssScore, StringFormat='Score CVSS : {0} / 10'}" 
                                                       FontSize="11" FontWeight="Bold" Foreground="#F0F6FC"/>
                                        </Border>

                                        <Border Background="#21262D" CornerRadius="3" Padding="8,3" Margin="0,0,6,4">
                                            <TextBlock Text="{Binding SelectedVulnerability.MatchStatusBadge, StringFormat='Statut : {0}'}" 
                                                       FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CyanAccent}"/>
                                        </Border>
                                    </WrapPanel>

                                    <!-- Vecteur CVSS -->
                                    <TextBlock Text="VECTEUR D'ATTAQUE (CVSS VECTOR)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding SelectedVulnerability.VectorString}" FontSize="11" FontFamily="Consolas, monospace" 
                                               Foreground="#00D2FF" Margin="0,2,0,10"/>

                                    <!-- Plage affectée et Version installée -->
                                    <TextBlock Text="VERSION INSTALLÉE &amp; PLAGE AFFECTÉE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding SelectedVulnerability.VulnerableRange, StringFormat='Intervalle vulnérable : {0}'}" 
                                               FontSize="11" Foreground="#F0F6FC" Margin="0,2,0,2"/>
                                    <TextBlock Text="{Binding SelectedVulnerability.InstalledVersion, StringFormat='Version installée détectée : {0}'}" 
                                               FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>

                                    <!-- Version corrigée & Patch -->
                                    <TextBlock Text="CORRECTIF DE SÉCURITÉ RECOMMANDÉ" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource GreenSafe}"/>
                                    <TextBlock Text="{Binding SelectedVulnerability.PatchedVersion, TargetNullValue='Aucune version spécifique documentée'}" 
                                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GreenSafe}" Margin="0,2,0,2"/>
                                    <TextBlock Text="{Binding SelectedVulnerability.RemediationRecommendation}" 
                                               FontSize="11.5" Foreground="#F0F6FC" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <!-- Description complète -->
                                    <TextBlock Text="DESCRIPTION DÉTAILLÉE DE LA VULNÉRABILITÉ" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding SelectedVulnerability.Description}" FontSize="11" Foreground="#C9D1D9" 
                                               TextWrapping="Wrap" Margin="0,2,0,14"/>

                                    <!-- Source et Référence -->
                                    <TextBlock Text="SOURCE &amp; RÉFÉRENCE OFFICIELLE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding SelectedVulnerability.SourceProvider}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,2"/>
                                    <TextBlock Text="{Binding SelectedVulnerability.ReferenceUrl}" FontSize="11" Foreground="{StaticResource CyanAccent}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <!-- Boutons d'action -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="📋 Copier CVE" Style="{StaticResource SecondaryButton}" 
                                                Command="{Binding CopyCveCommand}" Margin="0,0,8,0" Padding="12,6"/>
                                        <Button Content="🔗 Consulter Fiche NVD" Style="{StaticResource PrimaryButton}" 
                                                Command="{Binding OpenReferenceCommand}" Padding="12,6"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- ONGLET 4 : AUDIT SYSTÈME & VULNÉRABILITÉS  -->
            <!-- ========================================== -->
            <TabItem Header="🖥️ Audit Système &amp; Vulnérabilités" DataContext="{Binding Audit}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CyberCard}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentStep}" FontSize="12.5" Foreground="{StaticResource CyanAccent}" FontWeight="SemiBold"/>
                                <ProgressBar Height="4" Value="{Binding ProgressPercent}" Maximum="100" Margin="0,6,15,0"
                                             Foreground="{StaticResource CyanAccent}" Background="#21262D" BorderThickness="0"
                                             Visibility="{Binding IsAuditing, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="🚀 Lancer l'Audit Système (CVE/NVD)" Style="{StaticResource PrimaryButton}" 
                                    Margin="10,0,0,0" Command="{Binding RunAuditCommand}"/>

                            <Button Grid.Column="2" Content="⛔ Arrêter" Style="{StaticResource DangerButton}" 
                                    Margin="6,0,0,0" Command="{Binding CancelAuditCommand}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CyberCard}" Padding="0" Margin="0,0,0,8">
                            <DataGrid ItemsSource="{Binding InstalledApplications}" SelectedItem="{Binding SelectedApplication}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      Background="Transparent" RowBackground="#161B22" AlternatingRowBackground="#1C2129"
                                      BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#21262D"
                                      Foreground="#F0F6FC" SelectionMode="Single">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#21262D"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="11.5"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#30363D"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="APPLICATION" Binding="{Binding DisplayName}" Width="240" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="VERSION" Binding="{Binding DisplayVersion}" Width="110"/>
                                    <DataGridTextColumn Header="ÉDITEUR" Binding="{Binding Publisher}" Width="160"/>
                                    <DataGridTextColumn Header="SÉVÉRITÉ CVE" Binding="{Binding HighestSeverity}" Width="120" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="CVSS MAX" Binding="{Binding MaxCvssScore, StringFormat='{}{0:F1}'}" Width="90"/>
                                    <DataGridTextColumn Header="CPE CANONIQUE 2.3" Binding="{Binding CanonicalCpe}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="MÀJ DISPO" Binding="{Binding HasUpdateAvailable}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CyberCard}" Padding="0">
                            <DataGrid ItemsSource="{Binding SelectedApplication.Vulnerabilities}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      Background="Transparent" RowBackground="#161B22" AlternatingRowBackground="#1C2129"
                                      BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#21262D"
                                      Foreground="#F0F6FC" SelectionMode="Single">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#21262D"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="11.5"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#30363D"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="IDENTIFIANT CVE" Binding="{Binding CveId}" Width="140" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="SCORE CVSS" Binding="{Binding CvssScore, StringFormat='{}{0:F1}'}" Width="90"/>
                                    <DataGridTextColumn Header="SÉVÉRITÉ" Binding="{Binding Severity}" Width="100"/>
                                    <DataGridTextColumn Header="DESCRIPTION DU RISQUE" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="RECOMMANDATION CORRECTIVE" Binding="{Binding RemediationRecommendation}" Width="280"/>
                                    <DataGridTextColumn Header="DATE PUBLIÉE" Binding="{Binding PublishedAt, StringFormat='dd/MM/yyyy'}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- ONGLET 5 : GESTIONNAIRE DE MISES À JOUR    -->
            <!-- ========================================== -->
            <TabItem Header="⚡ Mises à Jour (WinGet)" DataContext="{Binding Updates}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Barre de Statut & Actions -->
                        <RowDefinition Height="Auto"/>  <!-- KPI Cards & Info WinGet -->
                        <RowDefinition Height="Auto"/>  <!-- Barre de Recherche & Filtres -->
                        <RowDefinition Height="3*"/>    <!-- Tableau des mises à jour -->
                        <RowDefinition Height="2*"/>    <!-- Console WinGet & Détails -->
                    </Grid.RowDefinitions>

                    <!-- LIGNE 1 : Barre de statut & Actions Principales -->
                    <Border Grid.Row="0" Style="{StaticResource CyberCard}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" Foreground="{StaticResource CyanAccent}" FontWeight="SemiBold"/>
                                <ProgressBar Height="4" Value="{Binding ProgressPercent}" Maximum="100" Margin="0,6,15,0"
                                             Foreground="{StaticResource CyanAccent}" Background="#21262D" BorderThickness="0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="🔄 Rechercher les Mises à Jour" Style="{StaticResource PrimaryButton}" 
                                    Margin="8,0,0,0" Command="{Binding CheckUpdatesCommand}"/>

                            <Button Grid.Column="2" Content="⚡ Mettre à Jour la Sélection" Style="{StaticResource SecondaryButton}" 
                                    Margin="6,0,0,0" Command="{Binding UpgradeSelectedCommand}"/>

                            <Button Grid.Column="3" Content="🛡️ Tout Mettre à Jour" Style="{StaticResource SecondaryButton}" 
                                    Margin="6,0,0,0" Command="{Binding UpgradeAllCommand}"/>

                            <Button Grid.Column="4" Content="⛔ Annuler" Style="{StaticResource DangerButton}" 
                                    Margin="6,0,0,0" Command="{Binding CancelOperationCommand}"/>
                        </Grid>
                    </Border>

                    <!-- LIGNE 2 : Cartes KPI et Statut WinGet -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mises à jour disponibles -->
                        <Border Grid.Column="0" Style="{StaticResource CyberCard}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="MISES À JOUR DISPONIBLES" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding TotalUpdatesCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AmberWarning}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Sécurité Critique -->
                        <Border Grid.Column="1" Style="{StaticResource CyberCard}" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="SÉCURITÉ CRITIQUE (CVE)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource RedDanger}"/>
                                <TextBlock Text="{Binding CriticalSecurityCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource RedDanger}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Logiciels à Jour -->
                        <Border Grid.Column="2" Style="{StaticResource CyberCard}" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="LOGICIELS À JOUR" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource GreenSafe}"/>
                                <TextBlock Text="{Binding UpToDateCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource GreenSafe}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Historique d'opérations -->
                        <Border Grid.Column="3" Style="{StaticResource CyberCard}" Margin="3,0,6,0">
                            <StackPanel>
                                <TextBlock Text="OPÉRATIONS JOURNALISÉES" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource CyanAccent}"/>
                                <TextBlock Text="{Binding HistoryCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource CyanAccent}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Diagnostic WinGet & Privilèges -->
                        <Border Grid.Column="4" Style="{StaticResource CyberCard}" Margin="3,0,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DIAGNOSTIC SYSTÈME WINGET" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding WinGetInfo}" FontSize="12" FontFamily="Consolas" Foreground="#00D2FF" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- LIGNE 3 : Filtres et Recherche -->
                    <Border Grid.Row="2" Style="{StaticResource CyberCard}" Margin="0,0,0,10" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#0D1117" Foreground="#F0F6FC" BorderBrush="{StaticResource BorderSubtle}"
                                     FontSize="12" Padding="8,6" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Filtrer :" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}" 
                                          Width="160" FontSize="12" Background="#21262D" Foreground="#F0F6FC" BorderBrush="{StaticResource BorderSubtle}"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="Historique" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding RefreshHistoryCommand}" Padding="10,5"/>
                        </Grid>
                    </Border>

                    <!-- LIGNE 4 : Tableau des Mises à Jour -->
                    <Border Grid.Row="3" Style="{StaticResource CyberCard}" Padding="0" Margin="0,0,0,8">
                        <DataGrid ItemsSource="{Binding FilteredUpdates}" SelectedItem="{Binding SelectedUpdate}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  Background="Transparent" RowBackground="#161B22" AlternatingRowBackground="#1C2129"
                                  BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#21262D"
                                  Foreground="#F0F6FC" SelectionMode="Single">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#21262D"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#30363D"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="APPLICATION" Binding="{Binding ApplicationName}" Width="230" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="IDENTIFIANT PACKAGE" Binding="{Binding PackageIdentifier}" Width="190" FontFamily="Consolas"/>
                                <DataGridTextColumn Header="VERSION ACTUELLE" Binding="{Binding CurrentVersion}" Width="130"/>
                                <DataGridTextColumn Header="VERSION DISPONIBLE" Binding="{Binding AvailableVersion}" Width="140" FontWeight="Bold"/>
                                <DataGridTextColumn Header="STATUT" Binding="{Binding StatusBadge}" Width="140" FontWeight="Bold"/>
                                <DataGridCheckBoxColumn Header="CORRECTIF CRITIQUE" Binding="{Binding HasCriticalSecurityPatch}" Width="130"/>
                                <DataGridTextColumn Header="DÉPÔT" Binding="{Binding SourceRepository}" Width="80"/>
                                <DataGridTextColumn Header="DÉTAIL" Binding="{Binding StatusMessage}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- LIGNE 5 : Console WinGet & Volet Détail -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Console WinGet Temps Réel -->
                        <Border Grid.Column="0" Style="{StaticResource CyberCard}" Padding="10" Margin="0,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="CONSOLE DE REMÉDIATION WINGET (OUTPUT STREAM SUPERVISÉ)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                    <Button Content="Effacer" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" 
                                            Padding="8,2" FontSize="11" Command="{Binding ClearLogsCommand}"/>
                                </Grid>

                                <TextBox Grid.Row="1" Text="{Binding ConsoleOutput, Mode=OneWay}" 
                                         IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="#0D1117" Foreground="#00D2FF" FontFamily="Consolas" FontSize="11.5"
                                         BorderBrush="#30363D" BorderThickness="1" Padding="8"/>
                            </Grid>
                        </Border>

                        <!-- Volet Détails du Package & Remédiation -->
                        <Border Grid.Column="1" Style="{StaticResource CyberCard}" Margin="6,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Visibility="{Binding HasSelectedUpdate, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding SelectedUpdate.ApplicationName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource CyanAccent}"/>
                                    <TextBlock Text="{Binding SelectedUpdate.PackageIdentifier, StringFormat='ID WinGet : {0}'}" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" Margin="0,2,0,10"/>

                                    <!-- Badges -->
                                    <WrapPanel Margin="0,0,0,10">
                                        <Border Background="#21262D" CornerRadius="3" Padding="8,3" Margin="0,0,6,4">
                                            <TextBlock Text="{Binding SelectedUpdate.StatusBadge}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AmberWarning}"/>
                                        </Border>
                                        <Border Background="#21262D" CornerRadius="3" Padding="8,3" Margin="0,0,6,4">
                                            <TextBlock Text="{Binding SelectedUpdate.FormattedVersions}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GreenSafe}"/>
                                        </Border>
                                    </WrapPanel>

                                    <!-- Alerte CVE critiques si applicables -->
                                    <Border Background="#2D1515" BorderBrush="{StaticResource RedDanger}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10"
                                            Visibility="{Binding SelectedUpdate.HasCriticalSecurityPatch, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="⚠️ VULNÉRABILITÉ CRITIQUE ASSOCIÉE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource RedDanger}"/>
                                            <TextBlock Text="Ce logiciel est affecté par des failles CVE majeures nécessitant une mise à jour immédiate." FontSize="11" Foreground="#F0F6FC" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="SOURCE ET DÉPÔT" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding SelectedUpdate.SourceRepository, StringFormat='Dépôt de distribution : {0}'}" FontSize="11.5" Foreground="#F0F6FC" Margin="0,2,0,10"/>

                                    <TextBlock Text="MESSAGE DU GESTIONNAIRE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding SelectedUpdate.StatusMessage}" FontSize="11.5" Foreground="#C9D1D9" TextWrapping="Wrap" Margin="0,2,0,14"/>

                                    <Button Content="⚡ Déployer cette Mise à Jour" Style="{StaticResource PrimaryButton}" 
                                            Command="{Binding UpgradeSelectedCommand}" HorizontalAlignment="Left" Padding="14,6"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- MODALE / OVERLAY DE CONFIRMATION DE SÉCURITÉ -->
                    <Grid Grid.RowSpan="5" Background="#CC0D1117" Visibility="{Binding IsConfirmationOpen, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource CyberCard}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                            <StackPanel>
                                <TextBlock Text="{Binding ConfirmationTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AmberWarning}" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding ConfirmationMessage}" FontSize="12.5" Foreground="#F0F6FC" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,20"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="❌ Annuler" Style="{StaticResource SecondaryButton}" 
                                            Command="{Binding DismissConfirmationCommand}" Margin="0,0,10,0" Padding="14,7"/>
                                    <Button Content="✅ Confirmer et Exécuter" Style="{StaticResource PrimaryButton}" 
                                            Command="{Binding ConfirmActionCommand}" Padding="16,7"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================================================== -->
            <!-- ONGLET 7 : HISTORIQUE DES ANALYSES & RAPPORTS                  -->
            <!-- ============================================================== -->
            <TabItem Header="📜 Historique &amp; Rapports" DataContext="{Binding History}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- LIGNE 1 : Recherche et Filtres -->
                    <Border Grid.Row="0" Style="{StaticResource CyberCard}" Margin="0,0,0,10" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#0D1117" Foreground="#F0F6FC" BorderBrush="{StaticResource BorderSubtle}"
                                     FontSize="12" Padding="8,6" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Verdict :" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding VerdictFilters}" SelectedItem="{Binding SelectedVerdictFilter}" 
                                          Width="150" FontSize="12" Background="#21262D" Foreground="#F0F6FC" BorderBrush="{StaticResource BorderSubtle}"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="🔄 Actualiser" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding RefreshCommand}" Margin="0,0,8,0" Padding="10,5"/>

                            <Button Grid.Column="3" Content="📄 Exporter Session (PDF)" Style="{StaticResource PrimaryButton}" 
                                    Command="{Binding ExportSessionPdfCommand}" Margin="0,0,6,0" Padding="12,5"/>

                            <Button Grid.Column="4" Content="💾 Export JSON" Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ExportSessionJsonCommand}" Padding="10,5"/>
                        </Grid>
                    </Border>

                    <!-- LIGNE 2 : Master-Detail (Sessions à gauche, Fichiers à droite) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tableau des Sessions d'Analyse -->
                        <Border Grid.Column="0" Style="{StaticResource CyberCard}" Padding="0" Margin="0,0,6,0">
                            <DataGrid ItemsSource="{Binding FilteredSessions}" SelectedItem="{Binding SelectedSession}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      Background="Transparent" RowBackground="#161B22" AlternatingRowBackground="#1C2129"
                                      BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#21262D"
                                      Foreground="#F0F6FC" SelectionMode="Single">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#21262D"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#30363D"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DATE DE SCAN" Binding="{Binding FormattedDate}" Width="135" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="TYPE DE SCAN" Binding="{Binding ScanTypeBadge}" Width="120"/>
                                    <DataGridTextColumn Header="VERDICT GLOBAL" Binding="{Binding GlobalVerdictBadge}" Width="130" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalFilesCount}" Width="55"/>
                                    <DataGridTextColumn Header="MENACES" Binding="{Binding MaliciousFilesCount}" Width="65"/>
                                    <DataGridTextColumn Header="SUSPECTS" Binding="{Binding SuspiciousFilesCount}" Width="65"/>
                                    <DataGridTextColumn Header="DURÉE" Binding="{Binding FormattedDuration}" Width="70"/>
                                    <DataGridTextColumn Header="CIBLE" Binding="{Binding TargetPath}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Volet Détails de la Session (Fichiers audités) -->
                        <Border Grid.Column="1" Style="{StaticResource CyberCard}" Padding="10" Margin="6,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,8" Visibility="{Binding HasSelectedSession, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding SelectedSession.TargetPath, StringFormat='Cible : {0}'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource CyanAccent}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SelectedSession.FormattedDate, StringFormat='Date : {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedSessionFiles}" AutoGenerateColumns="False" 
                                          CanUserAddRows="False" IsReadOnly="True"
                                          Background="Transparent" RowBackground="#161B22" AlternatingRowBackground="#1C2129"
                                          BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#21262D"
                                          Foreground="#F0F6FC">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#21262D"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="10.5"/>
                                            <Setter Property="Padding" Value="6,4"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#30363D"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="FICHIER" Binding="{Binding FileName}" Width="120" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="VERDICT" Binding="{Binding Verdict}" Width="75" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="DÉTECTEUR" Binding="{Binding DetectionSummary}" Width="110"/>
                                        <DataGridTextColumn Header="HASH SHA-256" Binding="{Binding Sha256Hash}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 4. BARRE DE STATUT EN BAS -->
        <Border Grid.Row="3" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Inventory.ScanStatus}" FontSize="11.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="CyberSentinel AI v1.0.0 (LTS .NET 10) | Multi-Engine EDR &amp; NVD Correlator" FontSize="11" Foreground="#484F58" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
